# Optional. `uv run glance baseline` asks for the model and key in the terminal, so this file is not required.
# Names only. Copy to .env (gitignored) and fill in if you prefer environment variables.
# LiteLLM model id of the frontier vision model, e.g. a provider-prefixed id.
FRONTIER_MODEL=
# Set the key that matches the provider of FRONTIER_MODEL.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
